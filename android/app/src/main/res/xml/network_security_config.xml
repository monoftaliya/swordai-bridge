<?xml version="1.0" encoding="utf-8"?>
<!-- Релизная сборка: только HTTPS/WSS, системные сертификаты. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
