# Публичный HTTPS-адрес сервера (на Render подставляется автоматически из RENDER_EXTERNAL_URL)
PUBLIC_URL=https://swordai-bridge.onrender.com

# Пароль администратора: вход в /admin и подтверждение подключения ChatGPT. Минимум 10 символов.
ADMIN_PASSWORD=придумайте-длинный-пароль

# Ключ подписи команд: PEM, base64(PEM) или любая случайная строка от 32 символов.
# Задайте его, если база данных может пропасть (бесплатный хостинг), иначе телефоны придётся сопрягать заново.
SIGNING_KEY=

# База данных. По умолчанию SQLite в ./data. Для бесплатного хостинга без диска — PostgreSQL (например, Neon).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///data/bridge.db

# Разрешённые хосты redirect_uri при регистрации OAuth-клиентов (через запятую)
OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com
# Разрешить redirect на localhost (MCP Inspector, локальные тесты)
ALLOW_LOOPBACK_REDIRECTS=true

# Тонкая настройка (значения по умолчанию)
# COMMAND_WAIT_SECONDS=50     сколько MCP-вызов ждёт телефон перед ответом "pending"
# COMMAND_TTL_SECONDS=120     сколько команда остаётся действительной
# OFFLINE_GRACE_SECONDS=12    сколько ждать переподключения телефона
# SCREENSHOT_LINKS=true       временные ссылки на скриншоты
# SCREENSHOT_LINK_TTL=300
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=7776000
# AUDIT_RETENTION_DAYS=30
# HEARTBEAT_SECONDS=20
# LOG_LEVEL=INFO
